# Slackbot HR Ops - Environment Variables

# =====================================================
# ANTHROPIC CLAUDE API
# =====================================================
ANTHROPIC_API_KEY=sk-ant-...

# =====================================================
# SLACK BOT CONFIGURATION
# =====================================================
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_LEVEL_TOKEN=xapp-...  # For Socket Mode
SLACK_HR_CHANNEL=hr-operations
SLACK_HR_CHANNEL_ID=C1234567890

# HR Team User IDs (comma-separated)
# Format: U123456,U123457,U123458
HR_TEAM_USER_IDS=

# =====================================================
# GOOGLE WORKSPACE
# =====================================================
# Contract templates folder
CONTRACTS_FOLDER_ID=...
CONTRACT_TEMPLATE_DOC_ID=...

# Email sending
GMAIL_SENDER=hr@yourcompany.com

# =====================================================
# EMPLOYEE DATA (GOOGLE SHEETS)
# =====================================================
EMPLOYEE_SHEET_ID=1VbRZ4q1VMxrwnDJGwVN9w1sUOBBWHmBf9yXRT0OAY4g
EMPLOYEE_SHEET_NAME=Active Employees

# Job descriptions folder
JD_FOLDER_ID=11ecKkt5NQ7LfjUBq9bxdaJ-oC1QqSW5A

# =====================================================
# DATABASE
# =====================================================
DB_PATH=hr_automation.db

# =====================================================
# SERVER CONFIGURATION
# =====================================================
# Flask server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=INFO
LOG_FILE=logs/slackbot.log

# =====================================================
# AGENT SDK CONFIGURATION
# =====================================================
# Conversation timeout in minutes
CONVERSATION_TIMEOUT_MINUTES=30

# =====================================================
# ONBOARDING CONFIGURATION
# =====================================================
# Default onboarding email template
ONBOARDING_TEMPLATE_KEY=internship_offer
